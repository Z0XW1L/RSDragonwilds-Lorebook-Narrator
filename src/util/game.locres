    "Cooking.ChanceToBurn.Major.T4.Name": "Culinary Confidence: Power Level 4",
    "Artisan.DecoratedAdventurer.Name": "Decorated Adventurer",
    "Woodcutting.LumberjackStamina.Desc": "Decreased Woodcutting stamina costs.",
    "Artisan.MakeItLast.Desc": "Decreased durability loss on equipment.",
    "Cooking.MinorNode.Stat1": "Delicious Food Chance at the Cooking Range",
    "Magic.Surge.Upgrade.Desc": "Distract your enemies by leaving behind an illusionary image for a short time when you use your first Surge Charge.",
