  "ST_ProfanityFilteringSettings": {
    "AlsoFilterOtherLanguage.Checkbox.Tooltip.Title": "Also filter this language",
    "AlsoFilterOtherLanguage.Checkbox": "Also filter {0}",
    "AlsoFilterOtherLanguage.Checkbox.Tooltip": "Also use the profanity lists of this language when filtering profanities.",
    "ProfanitiesFilteringType.Selector.Choice2": "Always",
    "EnableProfanityFilterCheckbox": "Enable Profanity Filtering",
    "FilterServerNamesCheckbox": "Filter Server names",
    "FilterUsernamesCheckbox": "Filter Usernames",
    "ProfanitiesFilteringType.Selector.Choice1": "Filter if full word",
    "ProfanitiesFilteringType.Selector.Choice3": "Ignore",
    "MildProfanitiesFilteringType.Selector": "Mild profanities",
    "StrongProfanitiesFilteringType.Selector.Tooltip": "Select how entries of that strength are used by the profanity filter system.\r\n\r\n- \"Always\" will always filter entries, even if they are in the middle of another word. For instance, if \"cat\" is a profanity, then \"scatter\" would be filtered to \"s***ter\" and \"caterpilar\" to \"***erpillar\".\r\n\r\n- \"Filter if full word\" will only filter entries that are surrounded by blank spaces or punctuation. For instance, if \"cow\" is a profanity, then \"coward\" will be unaltered, but \"cow\" will be filtered to \"***\".\r\n\r\n- \"Ignore\" will simply ignore this specific list.",
    "StrongProfanitiesFilteringType.Selector": "Strong profanities",
    "FilterServerNamesCheckbox.Tooltip": "Tick this box to apply profanity filter to Server names.",
    "FilterUsernamesCheckbox.Tooltip": "Tick this box to apply profanity filter to usernames. Note that usernames will not be filtered in the server users list so you can copy usernames for reporting purposes.",
    "EnableProfanityFilterCheckbox.Tooltip": "Tick this box to enable or disable profanity filtering. Profanity filtering applies to in-game chat and players' signs, and can optionally apply to usernames and server names."
  },
