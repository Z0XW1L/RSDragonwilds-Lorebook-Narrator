  "ST_EpicOnlineServices": {
    "ui.eos.loginAccept": "Continue with Epic Games",
    "ui.eos.login.CreateAccount": "Create Account",
    "ui.eos.login.CreateAndLink": "Create and Link",
    "ui.eos.loginDescriptionShort": "Epic Online Services link required to play online.",
    "ui.eos.loginMoreInfo": "More Info",
    "ui.eos.login.PlayOffline": "No, Play Offline",
    "ui.eos.loginPlayOffline": "Play offline",
    "ui.eos.loginHeader": "Playing online",
    "ui.eos.loginDescription": "This title uses Epic Account Services Basic Profile to connect players across platforms.\r\n\r\nBy pressing \"Continue with Epic Games\", you accept Epic Account Services Terms & Conditions. \r\nThe title will then verify whether your platform account is already linked with an Epic Account Services account. If not, the title will create an empty Epic account on your behalf and link it to your Platform account.\r\n\r\nYou can read more info on Epic Account Services and its Terms & Conditions by pressing \"More Info\".\r\n\r\nBasic Profile access enables the application to authenticate the user with Epic Online Services, access information like the user's screen name, and make in-application purchases. \r\nHowever, the application will never have access to the user's password or payment information.\r\n\r\nFinally, you could refuse and enjoy the game solo - it's still an amazing experience! And if you change your mind, you can come back to this screen by going to Settings > Legal > Epic Account Services."
  },
  "ST_Farming": {
    "FlavourText_T1_Plot": "A Plot made from Ash logs, plants found in Brynmoor grow better in this plot",
    "FlavourText_T2_Plot": "A Plot made from Oak logs, plants found in Ghornfell grow better in this plot",
