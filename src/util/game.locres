  "ST_Crafting": {
    "SmithAnvil.Description": "A Blacksmith's Anvil. Required for working with metals. ",
    "Kiln.Description": "A heated kiln, used to fire pottery. ",
    "LoomHarness.Description": "A loom improvement. The loom harness grants an additional slot to the loom, allowing the loom to weave more complex textiles.",
    "Grill.Description": "A much improved home cooking fire with no need for fuel",
    "Campfire.Description": "A nice hot fire on which to cook food or purify dirty water. ",
    "Tannery.Description": "A rack that slowly processes animal hide into leather.",
    "CraftingTable.Description": "A simple crafting station equipped with an array of primitive tools. It is used to craft equipment and other important resources.",
    "SpinningWheel.Description": "A spinning wheel can spin fibres such as flax or fleece into threads for crafting with.",
    "CookingPot.Description": "A sturdy pot over a campfire that can be used to combine ingredients to make better meals and infuse water with berries or other ingredients.",
    "TannersKit.Description": "A tannery improvement. The tanner's kit adds another build slot to the tanning station, allowing you to create more complex materials. ",
    "CookingRange.Description": "A workstation dedicated to cooking food. A cooking range can be used to cook hearty meals as well as individual raw foods.",
    "AdvancedFurnace": "Blast Furnace",
    "Buy": "Buy",
    "Furnace.Description": "By burning charcoal to create a blazing hot flame, the furnace is able to fire clay, and smelt ores into metal bars.",
    "CookingPot": "Cooking Pot",
    "CookingRange": "Cooking Range",
    "Craft": "Craft",
    "ItemCraftedPopupHeader": "Crafted",
