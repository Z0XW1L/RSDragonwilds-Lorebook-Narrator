  "ST_Skills_Perks": {
    "PassiveSkill.Empty.Desc": "-",
    "Farming.Humidify.SpecialRequirement": "50 units of water (clean or dirty)",
    "Woodcutting.Splinter.Desc": "A powerful spell that chops fallen trees into wood logs.",
    "Construction.PersonalChest.Desc": "Access your Personal Storage chest from anywhere.",
    "Attack.Adaptability.Name": "Adaptability",
    "Ranged.RangedProjectileRefundChance.Desc": "Adds a chance to be able to retrieve your arrows or bolts from your enemy's loot when they die.",
    "Cooking.AdeptCulinaromancer.Name": "Adept Culinaromancer",
    "Ranged.TrickShot.Desc": "After firing a fully draw arrow, release follow up shots at the right time for increased damage!",
    "Magic.Surge.Upgrade.Name": "Afterimage",
    "Magic.MagicFocus.Desc": "Allows crafting of magic focus at the Crafting Table, which can be used to imbue magic staves to increase their damage!",
    "Attack.Whetstone.Desc": "Allows crafting of whetstones at the Crafting Table, which can be used to sharpen melee weapons for increased damage!",
    "Woodcutting.ChopVines.Desc": "Allows you to cut down thorny vines with a hatchet, granting access to hidden or blocked areas.",
    "Mining.CrumbledWalls.Desc": "Allows you to knock down crumbled walls with a pickaxe, granting access to hidden or blocked areas.",
    "Cooking.AmateurCulinaromancer.Name": "Amateur Culinaromancer",
    "Ranged.RangedProjectileRefundChance.Name": "Ammo Recovery Chance",
    "Magic.ExtendCombo.Name": "Arcane Expertise",
    "Ranged.ArcheryTarget.Name": "Archery Target",
    "Attack.LesserPotion.Name": "Attack Potion",
    "Attack.MinorNode.Stat1": "Attack Stamina Costs",
    "Woodcutting.AxtralProjection.Name": "Axtral Projection",
    "Artisan.BarkToBones.Name": "Bark to Bones",
    "Construction.AdvancedStone.Name": "Bastion",
    "Construction.EyeOfOculus.Desc": "Become the mystical Eye of Oculus and build Structures easier and with a whole new perspective!",
    "Woodcutting.BirdNests.Name": "Bird Nests",
    "Cooking.BonesToPeaches.Name": "Bones to Peaches",
    "Ranged.ArcheryTarget.Desc": "Build an Archery Target to practice your Ranged accuracy against. Shoot the Bullseye for a surprise!",
    "Mining.DetectOre.Desc": "Call on the Stone Spirits to guide you to the nearest rocks you can mine!",
    "Artisan.Superheat.Desc": "Cast on fire-based stations to empower them and boost their processing speed for a while.",
    "Magic.Surge.Desc": "Channel arcane power into your dodges, travelling further and evading longer as a result.",
    "Farming.Harvest.Desc": "Channeling the power of the earth, summon a spectral surge that gently coaxes ripe plants from the soil. Within a small radius, all fully grown crops and wild plants are instantly harvested and drawn towards you",
    "Magic.SecondaryAttacks.Desc": "Charge up and release powerful secondary staff spells.",
    "Woodcutting.ChopVines.Name": "Chop Thorny Vines",
    "Attack.CombatProficiency.Name": "Combat Proficiency",
    "Magic.Confuse.Name": "Confuse",
    "Ranged.SnareTrap.Desc": "Conjure Earth Magic at your feet and lay a trap for your Enemies! Those caught inside this trap become rooted in place for a short time.",
    "Farming.Humidify.Desc": "Conjure Water magic to create a rain cloud that travels forward, instantly watering any Farming Plot that it passes over with Clean Water.",
    "Attack.TempestShield.Desc": "Conjure a Shield of Air Magic that prevents all damage while blocking for a limited time, triggering a powerful burst when the spell ends. Attack levels increase duration.",
    "Mining.Rocksplosion.Desc": "Conjure a powerful blast to break apart stone boulders and ore.",
    "Runecrafting.FireSpirit.Desc": "Conjure forth a fire spirit to light your way.",
    "Woodcutting.AxtralProjection.Desc": "Conjures an Astral Axe and launches it forward, instantly chopping down trees in its path.",
    "Construction.SummonShelter.Desc": "Construct a temporary Shelter through the power of Astral Magic. It even has a Bed!",
    "Ranged.CorruptionShot.Name": "Corruption Shot",
    "Construction.CreatureComforts.Name": "Creature Comforts",
    "Ranged.TrickShot.Upgrade.Name": "Crossbow Trick Shot",
    "Ranged.HuntersSense.Desc": "Crouch for a short time to activate your Hunter Senses, allowing you to sense nearby Creatures and Enemies.",
    "Cooking.ChanceToBurn.Major.T2.Name": "Culinary Confidence: Power Level 2",
