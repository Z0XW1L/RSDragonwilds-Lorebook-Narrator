    "ConfirmResetKeybindingsLeftButton": "Reset to default",
    "ServerSearchTitle": "Server Search",
    "HostClosedConnectionErrorBody": "The Host has closed the connection. Please try again.",
    "PasswordPromptBody": "This server requires a password. ",
    "FailedToJoinServerErrorBosy": "Unable to connect to server! Please try a different server.",
    "FailedToCreateWorldErrorBody": "Unable to create world! Please make sure you haven't already created a world with that name.",
    "FailedToLoadWorldSaveErrorBody": "Unable to load world!",
    "WarningMessageTitle": "Warning",
    "DedicatedServersNotAvailableBody": "We're sorry, but Dedicated Servers are not available yet.",
    "TelemetryBody": "With your consent, we would like to automatically collect information from this device via a new player activity plugin. This information allows our team to review how players use systems and play the game to better address issues, expand on old systems, or add new features. With both activity and player feedback we are able to make better decisions about the future of the game. If you choose, we can also use this information to offer a better online advertising experience.",
