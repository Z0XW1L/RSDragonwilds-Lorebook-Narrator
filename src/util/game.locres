    "NetworkUnknownErrorBody": "An unknown network error has occurred. Please try again.",
    "ConfirmDeleteCharacterBody": "Are you sure you want to delete this character?",
    "ConfirmDeleteWorldBody": "Are you sure you want to delete this world?",
    "ConfirmExitCharacterCreationBody": "Are you sure you want to leave character creation? Your changes will be lost.",
    "ConfirmResetKeybindingsBody": "Are your sure you want to reset all keybindings to default?\r\nThis will erase all your custom controls and cannot be undone.",
    "CharacterNameEmptyBody": "Character name cannot be empty.",
    "EOSRequiredToPlayOnlineBody": "Epic Online Services account required to play online. You can link your platform account with an Epic Online Services account in the settings.",
    "EOSMoreInfoBody": "Epic Online Services is required for online security and for future cross-play. For more information see Epic's Frequently Asked Questions page (it will open in a web browser).",
    "ErrorMessageTitle": "Error",
    "ServerPrivacyPromptBody": "How do you want to play?",
